{
  "version": 2,
  "builds": [
    {
      "src": "api/vercel_app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/vercel_app.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/vercel_app.py": {
      "runtime": "python3.9"
    }
  },
  "buildCommand": "echo 'Skipping build for Flask app'",
  "outputDirectory": ".",
  "installCommand": "pip install -r requirements.txt",
  "framework": null,
  "devCommand": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/vercel_app.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
